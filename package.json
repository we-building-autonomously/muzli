{
  "name": "muzli",
  "version": "0.1.0",
  "private": true,
  "description": "Modern open-source database management tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/we-building-autonomously/muzli"
  },
  "author": "Aviram Roizman <Aviram7168@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm --filter=web dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check",
    "clean": "pnpm --recursive clean"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}